<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="com.hypermall.controllers.PosController" style="-fx-background-color: #ffffff; -fx-padding: 10;">
    
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
        <Label text="👔 Salesman:" style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-font-size: 14px;"/>
        <ComboBox fx:id="salesmanComboBox" promptText="Select Salesman" prefWidth="200"/>
        <Button text="+ Add Salesman" onAction="#handleAddSalesman" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="AL MUSTAFA POS" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>
    </HBox>
    <HBox spacing="10" VBox.vgrow="SOMETIMES" prefHeight="320">
        <VBox spacing="5" HBox.hgrow="ALWAYS" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 8; -fx-background-color: #f8f9fa;">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="📦 Products" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                <TextField fx:id="posSearchField" promptText="Name / SKU" HBox.hgrow="ALWAYS" style="-fx-padding: 4;"/>
                <Button text="Add" onAction="#addToCart" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
            <TableView fx:id="searchResultTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="resNameCol" text="Name" prefWidth="180"/>
                    <TableColumn fx:id="resSkuCol" text="SKU" prefWidth="80"/>
                    <TableColumn fx:id="resPriceCol" text="Price" prefWidth="70"/>
                    <TableColumn fx:id="resStockCol" text="Stock" prefWidth="50"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 8; -fx-background-color: #f8f9fa;">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="👤 Customer" style="-fx-font-weight: bold; -fx-text-fill: #8e44ad;"/>
                <TextField fx:id="customerSearchField" promptText="Phone / Name" HBox.hgrow="ALWAYS" style="-fx-padding: 4;"/>
                <Button text="Link" onAction="#linkSelectedCustomer" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
            <TableView fx:id="customerSearchResultTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="custSearchNameCol" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="custSearchPhoneCol" text="Phone" prefWidth="110"/>
                    <TableColumn fx:id="custSearchBalanceCol" text="Owes" prefWidth="80"/>
                </columns>
            </TableView>
            <HBox alignment="CENTER_RIGHT">
                <Label fx:id="customerInfoLabel" text="Sale Blocked" style="-fx-font-size: 11px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Unlink" onAction="#clearCustomer" style="-fx-font-size: 10px; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </HBox>

    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🛒 Shopping Cart" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Separator HBox.hgrow="ALWAYS"/>
            <Button text="Remove Item" onAction="#removeCartItem" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 11px;"/>
        </HBox>
        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" editable="true">
            <columns>
                <TableColumn fx:id="cNameCol" text="Item Name" prefWidth="400"/>
                <TableColumn fx:id="cQtyCol" text="Qty" prefWidth="100"/>
                <TableColumn fx:id="cPriceTypeCol" text="Tier" prefWidth="150"/>
                <TableColumn fx:id="cPriceCol" text="Subtotal" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>

    <HBox spacing="20" alignment="CENTER_RIGHT" style="-fx-background-color: #2c3e50; -fx-padding: 12; -fx-background-radius: 5;">
        <VBox alignment="CENTER_LEFT">
            <Label fx:id="posTotalLabel" text="Grand Total: Rs.0.00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Paid: Rs." style="-fx-text-fill: #ecf0f1; -fx-font-weight: bold;"/>
                <TextField fx:id="posCashField" prefWidth="100"/>
                <Label fx:id="posChangeLabel" text="Change: Rs.0.00" style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Finalize &amp; Print" onAction="#submitSale" prefHeight="50" prefWidth="180" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;"/>
    </HBox>
</VBox>