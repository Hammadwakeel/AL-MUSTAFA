<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hypermall.controllers.MainLayoutController" style="-fx-background-color: #f4f7f6; -fx-pref-width: 1200; -fx-pref-height: 700;">
    
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 15 25; -fx-background-color: #2c3e50;">
            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label text="AL Mustafa Electric Wholesale Store" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="📍 Near HBL bank Jehangira  |  📞 03119396640, 03431216306" style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🛒 POS Terminal" onAction="#showPosView" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
            <Button text="📦 Inventory" onAction="#showInventoryView" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
            <Button text="👥 Khata / Customers" onAction="#showCustomerView" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
            
            <Button text="📊 Reports" onAction="#showReportsView" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
        </HBox>
    </top>
    
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;"/>
    </center>

</BorderPane>